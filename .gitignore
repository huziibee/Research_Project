# Environments and caches
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Local secrets
.env
.env.*
*.pem
*.key
_local_secrets/

# Model weights and large binaries
*.pt
*.bin
*.safetensors
*.ckpt
*.onnx
*.gguf

# Generated experiment outputs (keep the tracked directory marker)
outputs/**
!outputs/
!outputs/.gitkeep

# T12 runtime-only directories (fully gitignored)
outputs/hardware/
outputs/model_runs/
outputs/adapters/
outputs/model_cache/
outputs/environment_probes/

# T12 isolated environments
.venv-t12-*/

# Raw external dataset payloads: do not commit new payloads.
# Tracked dataset documentation/manifests live under configs/datasets/ or
# docs/dataset_cards/, never under data/raw. Currently tracked raw files are
# left untouched by this rule (git ignore does not untrack indexed files).
data/raw/**

# Local research records and annotations; publish reviewed metadata in docs/.
data/annotations/**
!data/annotations/
!data/annotations/.gitkeep
data/development/**

# Derived data workspaces (ignore generated content, keep directory markers)
data/interim/**
!data/interim/
!data/interim/.gitkeep
data/processed/**
!data/processed/
!data/processed/.gitkeep

# Local evidence, transfer archives, and release staging (preserved on disk)
/research_evidence_package_*/
/public_release_candidate_*/
/.t41_closure_work/
/pilot120_historical_annotation_handoff/
/pilot120_intent_evaluation_20260902/
/pilot120_semantic_intent_blind_judging_20260902/
/pilot120_t41_complete_closure/
/review_bundles/
/review_packs/
/results/
/latest results/
/t28-extract-final/
/*.zip
/*.tar
/*.tar.gz
/test-output.txt
/unneeded/
/context/
/patches/
/annotation_field_inventory.csv
/blind_adjudication_decisions.jsonl
/judge_C_adjudication.jsonl
