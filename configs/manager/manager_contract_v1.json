{
  "config_id": "manager_contract_v1",
  "version": "1.0.0",
  "status": "development",
  "frozen": false,
  "valid_for_official_use": false,
  "provenance": {
    "decision_id": "DEC-20260722-001",
    "author": "Mohammed Bangie",
    "created_for": "T16-T24 model-independent foundation",
    "schema_v2": "2.0.0"
  },
  "canonical_json": {
    "sort_keys": true,
    "separators": [",", ":"],
    "ensure_ascii": false,
    "hash_algorithm": "sha256"
  },
  "system_input_fields": [
    "record_id",
    "command",
    "dialogue_history",
    "scene_context",
    "capability_context",
    "input_provenance",
    "schema_version",
    "label_eligibility",
    "protected_data"
  ],
  "analysis_fields": [
    "speech_act",
    "intent_summary",
    "cpc",
    "candidate_interpretations",
    "selected_interpretation",
    "unresolved_slots",
    "resolved_slots",
    "supporting_evidence",
    "ambiguity_present",
    "ambiguity_types",
    "risk_level",
    "capability_status",
    "confidence_or_uncertainty",
    "analysis_provenance"
  ],
  "result_fields": [
    "record_id",
    "system_id",
    "system_version",
    "analysis",
    "recommended_strategy",
    "strategy_sequence",
    "clarification_targets",
    "clarification_question",
    "resolved_slots",
    "rejection_reason",
    "unsupported_commitment_findings",
    "safety_findings",
    "execution_status",
    "provider_provenance",
    "runtime_metadata",
    "result_hash"
  ],
  "notes": [
    "Reuse schema-v2 structures for CPC, candidates, evidence, routes, risk, and capability.",
    "Optional nulls follow T12 comparison-only materialisation policy; do not invent absent fields."
  ]
}
