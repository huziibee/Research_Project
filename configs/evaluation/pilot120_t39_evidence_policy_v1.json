    "ambiguity_type_min_support": 15,
    "ambiguity_pair_min_support": 10,
    "small_slice_policy": "count_only_no_ranking_or_generalised_conclusion"
  },
  "context_claim_boundary": "paired descriptive all-context removal only; no scene-only dialogue-only capability-only or causal claim",
  "not_computed": [
    "interpretation_cpc_candidate_quality",
    "clarification_rejection_silent_resolution_quality",
    "single_ambiguity_performance",
    "scene_dialogue_capability_isolated_effects",
    "generalisation"
  ]
}
