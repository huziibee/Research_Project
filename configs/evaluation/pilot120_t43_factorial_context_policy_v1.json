      "minimum_nonzero_within_record_effects_for_inferential_test": 10,
      "thin_strata_policy": "count_only_not_confirmatory",
      "dialogue_effect_population": "only records with a naturally non-empty frozen dialogue_history; empty histories are never recoded as a dialogue-removal treatment."
