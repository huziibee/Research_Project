{
  "config_id": "cpc_normalisation_v1",
  "version": "1.0.0",
  "status": "development",
  "frozen": false,
  "valid_for_official_use": false,
  "provenance": {
    "decision_id": "DEC-20260722-001",
    "author": "Mohammed Bangie",
    "created_for": "T24 CPC deterministic normalisation"
  },
  "canonical_json": {
    "sort_keys": true,
    "separators": [",", ":"],
    "ensure_ascii": false,
    "hash_algorithm": "sha256"
  },
  "rules": {
    "lowercase": true,
    "strip_whitespace": true,
    "collapse_internal_whitespace": true,
    "drop_trailing_punctuation": true
  },
  "critical_slots": [
    "action",
    "object",
    "destination",
    "tool",
    "conditions",
    "constraints"
  ],
  "scorable_statuses": [
    "filled"
  ],
  "notes": [
    "Do not use fuzzy LLM equivalence.",
    "Normalisation is deterministic and versioned."
  ]
}
