        "run_manifest.json",
        "source_identity_manifest.json"
      ],
      "run_id_prefix": "t12-qlora-smoke",
      "training_site_packages_relpath": "training-site-packages",
      "exclude_nodes": "mscluster107,mscluster108",
      "exclude_nodes_note": "mscluster107 and mscluster108 reject unprivileged Apptainer user-namespace mappings (setgroups permission denied). Do not permanently pin a single success node; use scheduler selection among eligible GPUs."
    },
