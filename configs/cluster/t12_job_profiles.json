      "container_role": "training",
      "container_sif_default_relpath": "containers/pytorch-2.11.0-cuda13.0-runtime.sif",
      "container_sif_note": "Separate training runtime: pulled pytorch CUDA runtime SIF plus bind-mounted training-site-packages (peft/bitsandbytes/accelerate). Never uses or overwrites the pinned vllm-openai-v0.20.1.sif inference container.",
