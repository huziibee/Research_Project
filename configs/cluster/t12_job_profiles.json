{
  "schema_version": "1.0.0",
  "default_ssh_alias": "wits-mscluster",
  "cluster_root_env": "T12_CLUSTER_ROOT",
  "cluster_root_default_remote": "$HOME/t12-hpc",
  "profiles": {
    "canary": {
      "description": "Lightweight CPU-only operator/infrastructure canary (no model, no GPU).",
      "partition": "stampede",
      "time_limit": "00:10:00",
      "memory_mb": 4000,
      "cpus": 1,
      "gpus_required": false,
      "sbatch_strict_mode": true,
      "job_name": "t12-canary",
      "entry_point": "scripts/t12_cluster_canary.py",
      "required_branch": "feature/t12-cluster-redesign",
      "remote_result_root_template": "${T12_CLUSTER_ROOT}/runs/t12-canary",
      "expected_result_files": [
        "canary_result.json",
        "canary_records.jsonl",
        "run_manifest.json",
        "source_identity_manifest.json"
      ],
      "run_id_prefix": "t12-canary"
    },
    "model_candidate_preflight": {
      "description": "GPU preflight for one allowlisted development model candidate (metadata/tokenizer/runtime; no full generation).",
      "partition": "biggpu",
      "time_limit": "00:45:00",
      "memory_mb": 64000,
      "cpus": 8,
      "gpus_required": true,
      "gpus": 1,
      "exclusive": true,
      "requires_candidate_id": true,
      "job_name": "t12-mc-preflight",
      "entry_point": "scripts/t12_model_candidate_preflight.py",
      "entry_args": "--candidate-id {candidate_id}",
      "required_branch": "feature/t12-cluster-redesign",
      "remote_result_root_template": "${T12_CLUSTER_ROOT}/runs/model-candidate-preflight",
      "expected_result_files": [
        "preflight_result.json",
        "candidate_provenance.json",
        "run_manifest.json",
        "source_identity_manifest.json"
      ],
      "run_id_prefix": "t12-mc-preflight"
    },
    "model_candidate_transport_smoke": {
      "description": "Four-record development transport smoke for one allowlisted model candidate.",
      "partition": "biggpu",
      "time_limit": "01:30:00",
      "memory_mb": 64000,
      "cpus": 8,
      "gpus_required": true,
      "gpus": 1,
      "exclusive": true,
      "requires_candidate_id": true,
      "job_name": "t12-mc-transport",
      "entry_point": "scripts/t12_model_candidate_transport_smoke.py",
      "entry_args": "--candidate-id {candidate_id}",
      "required_branch": "feature/t12-cluster-redesign",
      "remote_result_root_template": "${T12_CLUSTER_ROOT}/runs/model-candidate-transport-smoke",
      "expected_result_files": [
        "transport_smoke_summary.json",
        "raw_attempts.jsonl",
        "attempt_ledgers.jsonl",
        "accepted_predictions.jsonl",
        "record_results.jsonl",
        "analysis_outputs.jsonl",
        "run_manifest.json",
        "source_identity_manifest.json"
      ],
      "run_id_prefix": "t12-mc-transport"
    },
    "model_candidate_bakeoff": {
      "description": "Full frozen development-set bake-off (full_context + context_blind) for one allowlisted candidate.",
      "partition": "biggpu",
      "time_limit": "08:00:00",
      "memory_mb": 64000,
      "cpus": 8,
      "gpus_required": true,
      "gpus": 1,
      "exclusive": true,
      "requires_candidate_id": true,
      "job_name": "t12-mc-bakeoff",
      "entry_point": "scripts/t12_model_candidate_bakeoff.py",
      "entry_args": "--candidate-id {candidate_id}",
      "required_branch": "feature/t12-cluster-redesign",
      "remote_result_root_template": "${T12_CLUSTER_ROOT}/runs/model-candidate-bakeoff",
      "expected_result_files": [
        "bakeoff_summary.json",
        "metrics_summary.json",
        "raw_attempts.jsonl",
        "attempt_ledgers.jsonl",
        "accepted_predictions.jsonl",
        "analysis_cache_entries.jsonl",
        "record_results.jsonl",
        "run_manifest.json",
        "source_identity_manifest.json"
      ],
      "run_id_prefix": "t12-mc-bakeoff"
    },
    "qlora_smoke": {
      "description": "GPU technical smoke of the QLoRA adaptation pipeline mechanics (frozen base, trainable adapter, separate save/reload, resume) on a tiny deterministic source_train subset for the frozen selected_base_model. Development-only; never an official training claim and never sets selected_adapter.",
      "partition": "biggpu",
      "time_limit": "01:00:00",
      "memory_mb": 64000,
      "cpus": 8,
      "gpus_required": true,
      "gpus": 1,
      "exclusive": true,
      "requires_candidate_id": false,
      "container_role": "training",
      "container_sif_default_relpath": "containers/pytorch-2.11.0-cuda13.0-runtime.sif",
      "container_sif_note": "Separate training runtime: pulled pytorch CUDA runtime SIF plus bind-mounted training-site-packages (peft/bitsandbytes/accelerate). Never uses or overwrites the pinned vllm-openai-v0.20.1.sif inference container.",
      "job_name": "t12-qlora-smoke",
      "entry_point": "scripts/t12_qlora_smoke.py",
      "required_branch": "feature/t12-cluster-redesign",
      "remote_result_root_template": "${T12_CLUSTER_ROOT}/runs/qlora-smoke",
      "expected_result_files": [
        "qlora_smoke_result.json",
        "adapter_identity.json",
        "loss_mask_summary.json",
        "run_manifest.json",
        "source_identity_manifest.json"
      ],
      "run_id_prefix": "t12-qlora-smoke",
      "training_site_packages_relpath": "training-site-packages",
      "exclude_nodes": "mscluster107",
      "exclude_nodes_note": "mscluster107 rejects unprivileged Apptainer user-namespace mappings (setgroups permission denied). Do not permanently pin a single success node; use scheduler selection among eligible GPUs."
    },
    "qlora_task_aligned_smoke": {
      "description": "GPU task-aligned QLoRA technical smoke: structured-target supervision, real token loss masks, full checkpoint/resume, strict structured-output validation on a frozen four-record source_dev set. Development-only; never sets selected_adapter; never silently falls back to mock.",
      "partition": "biggpu",
      "time_limit": "01:30:00",
      "memory_mb": 64000,
      "cpus": 8,
      "gpus_required": true,
      "gpus": 1,
      "exclusive": true,
      "requires_candidate_id": false,
      "container_role": "training",
      "container_sif_default_relpath": "containers/pytorch-2.11.0-cuda13.0-runtime.sif",
      "container_sif_note": "Separate training runtime: pulled pytorch CUDA runtime SIF plus bind-mounted training-site-packages. Never uses or overwrites the pinned vllm-openai-v0.20.1.sif inference container.",
      "job_name": "t12-qlora-task-aligned",
      "entry_point": "scripts/t12_qlora_task_aligned_smoke.py",
      "required_branch": "feature/t12-cluster-redesign",
      "remote_result_root_template": "${T12_CLUSTER_ROOT}/runs/qlora-task-aligned-smoke",
      "expected_result_files": [
        "qlora_task_aligned_smoke_result.json",
        "adapter_identity.json",
        "loss_mask_summary.json",
        "structured_output_results.json",
        "resume_components.json",
        "run_manifest.json",
        "source_identity_manifest.json"
      ],
      "run_id_prefix": "t12-qlora-task-aligned",
      "training_site_packages_relpath": "training-site-packages",
      "exclude_nodes": "mscluster107",
      "exclude_nodes_note": "Exclude only documented incompatible nodes. No permanent nodelist pin."
    },
    "qlora_smoke_mock": {
      "description": "Explicit CPU/mock contract-proof profile for QLoRA software mechanics without real 4-bit training. Never selected automatically by the live task-aligned profile.",
      "partition": "stampede",
      "time_limit": "00:20:00",
      "memory_mb": 8000,
      "cpus": 2,
      "gpus_required": false,
      "requires_candidate_id": false,
      "job_name": "t12-qlora-mock",
      "entry_point": "scripts/t12_qlora_smoke.py",
      "entry_args": "--force-mock",
      "required_branch": "feature/t12-cluster-redesign",
      "remote_result_root_template": "${T12_CLUSTER_ROOT}/runs/qlora-smoke-mock",
      "expected_result_files": [
        "qlora_smoke_result.json",
        "adapter_identity.json",
        "loss_mask_summary.json",
        "run_manifest.json",
        "source_identity_manifest.json"
      ],
      "run_id_prefix": "t12-qlora-mock",
      "exclude_nodes": "mscluster107",
      "exclude_nodes_note": "mscluster107 rejects unprivileged Apptainer user-namespace mappings."
    }
  }
}
