{
  "schema_version": "1.0.0",
  "description": "Schema for append-only deviation log entries.",
  "required_fields": [
    "deviation_id",
    "date",
    "status",
    "change_type",
    "approver",
    "approval_basis",
    "protocol_version_before",
    "protocol_version_after",
    "affected_tickets",
    "affected_artefacts",
    "summary",
    "rationale",
    "evidence",
    "risk",
    "required_reruns",
    "protected_test_implications",
    "preservation_of_prior_outputs",
    "ethics_disclaimer"
  ],
  "status_allowed": ["proposed", "accepted", "rejected"],
  "change_types_allowed": [
    "execution_order_exception",
    "protocol_amendment",
    "licence_exception",
    "metric_exception",
    "schedule_exception",
    "deviation_closure"
  ],
  "deviation_closure_required_fields": [
    "closes_deviation_id",
    "closure_basis"
  ],
  "deviation_id_pattern": "^DEV-[0-9]{8}-[0-9]{3}$",
  "date_pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
  "ticket_id_pattern": "^T(0[0-9]|[12][0-9]|3[0-8])$",
  "log_path": "docs/governance/logs/deviation_log.jsonl",
  "append_only": true
}
