{
  "schema_version": "1.0.0",
  "description": "Human annotation governance and ethics determination record.",
  "determination_status_allowed": [
    "pending",
    "not_required",
    "approved",
    "exempt_confirmed",
    "approval_required",
    "rejected",
    "blocked"
  ],
  "determination_basis_allowed": [
    "supervisor_only_annotation"
  ],
  "annotator_scope_allowed": [
    "project_supervisors_only"
  ],
  "not_required_required_fields": [
    "determination_basis",
    "ethics_clearance_required",
    "ethics_waiver_required",
    "annotator_scope",
    "external_annotators_permitted",
    "reassessment_required_if_scope_changes",
    "collection_permitted",
    "determination_status_evidence",
    "determination_evidence",
    "external_annotator_recruitment",
    "external_participant_recruitment",
    "incentives_offered",
    "external_consent_workflow"
  ],
  "determination_evidence_required_fields": [
    "evidence_id",
    "evidence_path",
    "evidence_date",
    "evidence_type"
  ],
  "pending_field_status": "pending_human_confirmation",
  "collection_permitted_semantics": {
    "not_required": "Ethics/governance gate permits annotation only by the named project supervisors under the recorded supervisor-only scope. Does not imply T13/T14 technical readiness or permission for external annotators."
  }
