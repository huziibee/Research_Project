{
  "schema_version": "1.0.0",
  "description": "Schema for append-only generative AI use log entries.",
  "required_fields": [
    "entry_id",
    "recorded_at",
    "activity_period",
    "time_precision",
    "historical_backfill",
    "project_ticket",
    "use_categories",
    "tools",
    "purpose",
    "input_data_classification",
    "protected_data_involved",
    "outputs_affected",
    "human_review_status",
    "disposition",
    "disclosure_category"
  ],
  "use_categories_allowed": [
    "planning",
    "coding",
    "debugging",
    "data_authoring",
    "annotation_support",
    "model_inference",
    "analysis",
    "writing"
  ],
  "time_precision_allowed": ["exact", "period_only", "not_recorded"],
  "tool_model_status_allowed": ["not_recorded", "recorded"],
  "log_path": "docs/governance/logs/generative_ai_use_log.jsonl",
  "append_only": true
}
