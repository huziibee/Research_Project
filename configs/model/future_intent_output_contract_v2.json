{
  "contract_id": "future_intent_output_contract_v2",
  "status": "future_only_not_t39",
  "required_fields": [
    "speech_act",
    "intent_summary",
    "pilot_ambiguity_types",
    "pilot_capability_status",
    "risk_level",
    "unresolved_slots",
    "uncertainty"
  ],
  "intent_summary_constraints": {
    "min_length": 3,
    "max_length": 500,
    "must_preserve_polarity": true,
    "must_preserve_top_level_actions": true,
    "verbatim_command_copy_forbidden": true,
    "route_decision_forbidden": true,
    "cpc_enumeration_not_required": true,
    "chain_of_thought_forbidden": true
  },
  "frozen_t39_compatibility": "not_applicable; frozen T39 remains unchanged with intent_summary normalized to null"
}
