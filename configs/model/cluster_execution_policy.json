{
  "schema_version": "1.0.0",
  "required_partition": "biggpu",
  "require_exclusive_node": true,
  "gpu_gres_mode": "not_configured_at_measurement_time",
  "allowed_gpu_classes": [
    {
      "name_pattern": "NVIDIA RTX PRO 6000 Blackwell",
      "minimum_vram_mib": 90000,
      "minimum_compute_capability": "12.0"
    }
  ],
  "node_allowlist": [],
  "node_denylist": [],
  "reject_unapproved_gpu": true,
  "require_offline_model_resolution_for_acceptance": true,
  "shared_storage_root_env": "T12_CLUSTER_ROOT",
  "node_local_temp_template": "/var/tmp/${USER}-apptainer-${SLURM_JOB_ID}"
}
