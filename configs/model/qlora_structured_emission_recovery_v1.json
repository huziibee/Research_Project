{
  "config_id": "qlora_structured_emission_recovery_v1",
  "config_version": "1.0.0",
  "ticket": "T27B",
  "purpose": "Production-schema structured-emission recovery: full_schema_envelope_v1 training targets, segment-aware loss masks, and multi-stage structured-output validation on a sealed eight-record source_dev set. Never selects an adapter or model strategy.",
  "development_only": true,
  "valid_for_official_use": false,
  "technical_smoke_only": true,
  "requires_selected_base_model": true,
  "selected_base_model_source": "configs/model/selected_identities_v1.json#selected_base_model",
  "selected_adapter": null,
  "selected_model_strategy": null,
  "no_merge_into_base": true,
  "forbid_manual_or_protected_eval": true,
  "forbid_mock_fallback_in_live_mode": true,
  "require_real_mode": true,
  "require_real_mode_on_cluster": true,
  "no_mock_fallback": true,
  "envelope_id": "full_schema_envelope_v1",
  "prompt_contract": "t27b_full_schema_prompt_v1",
  "allowed_data_manifest": "data/development/qlora_structured_emission_recovery_v1/manifest.json",
  "allowed_validation_manifest": "data/development/t27b_final_smoke_v1/manifest.json",
  "allowed_diagnostic_manifest": "data/development/t27b_diagnostic_dev_v1/manifest.json",
  "allowed_source_split": "source_train",
  "validation_source_split": "source_dev",
  "forbidden_data_sources": [
    "source_holdout",
    "model_selection_development_set_v1",
    "t13_calibration",
    "future_manual_namespace",
    "manual_protected_challenge_set",
    "protected_data",
    "job6059_validation_ids",
    "qlora_task_aligned_smoke_v2",
    "qlora_smoke_v1",
    "supervisor_annotations"
  ],
  "base_model_policy": {
    "frozen": true,
    "allow_arbitrary_repository": false,
    "exact_revision_required": true,
    "note": "Must use exact Qwen3-8B revision from selected_identities_v1.json (Qwen/Qwen3-8B@b968826d9c46dd6066d109eabc6255188de91218)."
  },
  "quantization": {
    "bits": 4,
    "quant_type": "nf4",
    "compute_dtype": "bfloat16",
    "double_quant": true
  },
  "adapter": {
    "method": "lora",
    "rank": 8,
    "alpha": 16,
    "dropout": 0.05,
    "target_modules": ["q_proj", "k_proj", "v_proj", "o_proj"],
    "bias": "none",
    "task_type": "CAUSAL_LM"
  },
  "sequence": {
    "max_seq_len": 1536,
    "truncation": true,
    "padding": "longest_in_batch",
    "note": "Full production envelope is larger than partial training_semantic_target_v1; 1536 leaves headroom for prompt+envelope under the real tokenizer."
  },
  "training": {
    "seed": 20260723,
    "micro_batch_size": 1,
    "gradient_accumulation_steps": 1,
    "max_steps": 24,
    "checkpoint_interval_steps": 12,
    "learning_rate": 0.0002,
    "resume_test": true,
    "resume_from_checkpoint_step": 12,
    "optimizer": "adamw",
    "scheduler": "constant",
    "structured_targets": true,
    "full_schema_envelope": true,
    "real_token_masks": true,
    "forbid_command_reconstruction": true,
    "forbid_fabricated_supervised_negatives": true
  },
  "evaluation": {
    "held_out_validation_manifest": "data/development/t27b_final_smoke_v1/manifest.json",
    "diagnostic_manifest": "data/development/t27b_diagnostic_dev_v1/manifest.json",
    "strict_structured_output": true,
    "forbid_braces_only_acceptance": true,
    "max_new_tokens": 768,
    "identical_prompt_and_settings_for_base_and_adapter": true,
    "multi_stage_validation": true
  },
  "pass_thresholds": {
    "frozen_before_live_results": true,
    "frozen_at": "2026-07-23T00:00:00Z",
    "sealed_final_count": 8,
    "adapter_parse_valid_min": 6,
    "adapter_schema_valid_min": 5,
    "adapter_semantic_valid_min": 1,
    "adapter_safety_accepted_min": 1,
    "adapter_final_accepted_min": 1,
    "adapter_differs_from_base_min": 1,
    "unsupported_commitment_accepted_max": 0,
    "base_attempted_min": 8,
    "adapter_attempted_min": 8,
    "note": "Thresholds were frozen before any live T27B run."
  },
  "minimum_useful_supervision": {
    "frozen_before_live_results": true,
    "min_semantic_supervised_tokens_per_example": 1,
    "min_structural_supervised_tokens_per_example": 1,
    "min_mean_supervised_token_percentage": 12.0
  },
  "output": {
    "adapter_output_dir": "outputs/qlora_structured_emission_recovery_v1/adapters",
    "checkpoint_dir_template": "outputs/qlora_structured_emission_recovery_v1/checkpoints/{run_id}",
    "note": "Adapter and full checkpoints are written under outputs/, never into the immutable base snapshot."
  },
  "references": {
    "envelope_policy": "configs/model/full_schema_envelope_policy_v1.json",
    "coverage_audit": "configs/model/t27b_production_schema_coverage_v1.json",
    "compatibility_audit": "docs/reports/ticket_T27B_target_schema_compatibility_audit.md",
    "training_target_policy": "configs/data/training_target_policy_v1.json",
    "selected_identities": "configs/model/selected_identities_v1.json",
    "retained_t27_evidence": "configs/model/evidence/t27_task_aligned_qlora_smoke.json"
  },
    "notes": [
      "technical_smoke_only=true; selected_adapter remains null; selected_model_strategy remains null; valid_for_official_use=false.",
      "Pass thresholds and minimum_useful_supervision were frozen before any live T27B results.",
      "Do not overwrite T27 job 6059 evidence artefacts."
    ]
